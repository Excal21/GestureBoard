{
    "Egérmód ki/be": "self.toggleMouseMode()",
    "Böngésző elindítása": "os.system('start http://www.google.com')",
    "Feladatkezelő": "os.system('start taskmgr')",
    "Képernyőkép készítése": "pyautogui.press('printscreen')",
    "Számológép": "os.system('start calc')",
    "Gmail": "os.system('start http://www.gmail.com')",
    "YouTube": "os.system('start http://www.youtube.com')",
    "YouTube Music": "os.system('start http://music.youtube.com')",
    "Google Maps": "os.system('start http://maps.google.com')",
    "OneDrive": "os.system('start https://onedrive.live.com')",
    "Lejátszás/ szünet": "pyautogui.press('playpause')",
    "Következő szám": "pyautogui.press('nexttrack')",
    "Előző szám": "pyautogui.press('prevtrack')",
    "Hangerő növelése": "pyautogui.press('volumeup')",
    "Hangerő csökkentése": "pyautogui.press('volumedown')",
    "Alt + Tab": "pyautogui.hotkey('alt', 'tab')",
    "Asztal megjelenítése": "pyautogui.hotkey('win', 'd')",
    "Windows + Jobbra": "pyautogui.hotkey('win', 'right')",
    "Windows + Balra": "pyautogui.hotkey('win', 'left')",
    "Windows + Fel": "pyautogui.hotkey('win', 'up')",
    "Windows + Le": "pyautogui.hotkey('win', 'down')"
}